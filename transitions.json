  "transitions": {
    "edge_sweep": {
      "duration_ms": 600,
      "role": "beat → beat, chapter changes (the default)",
      "geometry": {
        "reveal": "x < W·E(u)",
        "band_width": 0.0125,
        "band_side": "trailing (left of the reveal edge)"
      }
    },
    "boot_seam": {
      "duration_ms": 400,
      "role": "brand boundaries: splash → title card, content → outro",
      "geometry": {
        "reveal": "H·(1−E)/2 ≤ y < H·(1+E)/2",
        "seam_width": 0.004166666666666667,
        "seam_opacity": "1 − E(u)"
      }
    }
  }
